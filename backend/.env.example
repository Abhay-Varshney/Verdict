# ── Core ────────────────────────────────────────────────────────────────
APP_NAME="Verdict"
SECRET_KEY="change-me-to-a-long-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT="development"

# ── Database ────────────────────────────────────────────────────────────
# SQLite (zero-config, default). For Postgres use e.g.:
# DATABASE_URL="postgresql+psycopg2://user:pass@localhost:5432/verdict"
DATABASE_URL="sqlite:///./data/app.db"

# ── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ── LLM provider ────────────────────────────────────────────────────────
# Provider: "anthropic", "openai", or "mock" (mock runs with no key/network).
LLM_PROVIDER="mock"
LLM_MODEL="claude-sonnet-4-20250514"

# Supply the key for your chosen provider. Leave blank to force mock mode.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ── Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=15

# ── Rate limiting (per IP, per window) ──────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
